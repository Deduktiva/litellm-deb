#!/bin/sh
set -e

# Only a removal cleans up; upgrade and abort-* leave everything in place.
# /etc/litellm is kept as conffiles until purge. Everything else, including
# the venv, is dpkg-tracked and removed by the package itself.
if [ "$1" = "remove" ]; then
    rm -rf /opt/litellm
    userdel litellm || true
fi

exit 0
