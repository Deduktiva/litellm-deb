[Unit]
Description=LiteLLM proxy (packaged from PyPI)
Documentation=https://github.com/BerriAI/litellm
After=network-online.target
Wants=network-online.target

[Service]
User=litellm
Environment=PIPX_HOME=/opt/litellm
EnvironmentFile=-/etc/litellm/litellm.env
ExecStart=/opt/litellm/venvs/litellm/bin/litellm --config /etc/litellm/config.yaml --host 127.0.0.1 --port 4000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
